# ID do Meta Pixel (público, vai para o navegador)
NEXT_PUBLIC_META_PIXEL_ID=

# Token da API de Conversões (Events Manager > Configurações). NUNCA commitar.
META_ACCESS_TOKEN=

# Opcional: código da aba "Testar eventos" do Events Manager (remova em produção)
META_TEST_EVENT_CODE=

# Opcional: versão da Graph API (padrão v24.0)
META_GRAPH_VERSION=

# Opcional: domínio público, usado no sitemap e nas prévias de link.
# Na Vercel é detectado automaticamente.
NEXT_PUBLIC_SITE_URL=
